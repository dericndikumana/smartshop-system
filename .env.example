# .env.example
# SmartShop System Environment Variables

# Neon PostgreSQL Database URL
DATABASE_URL="postgresql://user:password@hostname:5432/dbname?sslmode=require"

# NextAuth Configuration
# Run `npx auth secret` or `openssl rand -base64 32` to generate a secret
NEXTAUTH_SECRET="replace-with-a-secure-random-string"
NEXTAUTH_URL="http://localhost:3000"
